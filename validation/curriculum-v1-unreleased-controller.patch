+"""Single-use local curriculum campaign with exact continuation and owned watchdog."""
+import argparse,json,os,shutil,subprocess,sys,tarfile,time
+from pathlib import Path
+ROOT=Path(__file__).resolve().parents[1];sys.path.insert(0,str(ROOT))
+from experiments.learner import curriculum_training as c
+from experiments.learner.builtin_training_resume import binding,require
+from experiments.learner.builtin_preservation import verify_pair
+from experiments.learner.inference import source_identity
+from experiments.headless.contextual_evidence import runtime_identity
+from experiments.headless.process_deadline import guarded_popen,close_owned_process,cleanup_from_evidence
+REPO=Path('/Users/orsi/Projects/Heroes-artifacts/private-local365-state')
+
+
+def git(*a):return subprocess.check_output(['git','-C',str(REPO),*a],text=True,timeout=60).strip()
+
+def private_preflight():
+    require(git('remote','get-url','origin')=='https://github.com/tkorsi/heroes-rl-training-state.git'
+        and git('branch','--show-current')=='codex/local365-teacher-results' and git('status','--porcelain')=='','Private repository not ready')
+
+def save(v):
+    path=c.SESSION.parent/'campaign-report.json';tmp=path.with_suffix('.tmp');tmp.write_text(json.dumps(v,indent=2)+'\n');os.replace(tmp,path)
+    s=json.loads(c.SESSION.read_text())
+    status=dict(timestamp_utc=__import__('datetime').datetime.now(__import__('datetime').timezone.utc).isoformat(),
+        phase=v['status'],actual_session_path=str(c.SESSION),source=s['source'],runtime=s['runtime'],
+        confirmed_games=sum(b.get('completed_games',0) for b in v['batches']),ppo_updates=v.get('new_updates',0),
+        latest_preserved_checkpoint=v.get('latest_private_parent'),latest_verified_checkpoint=v['latest_verified_parent'],
+        launch=s['started_unix'],compute_deadline=s['compute_deadline_unix'],hard_deadline=s['absolute_deadline_unix'],
+        validation_outcomes=s['validation_outcomes'])
+    p=c.BASE/'campaign-status.json';tmp=p.with_suffix('.tmp');tmp.write_text(json.dumps(status,indent=2)+'\n');os.replace(tmp,p)
+
+def publish(folder,label,checkpoint=False):
+    private_preflight();dest=REPO/'results/local-curriculum-update146'/label
+    require(not dest.exists(),'Private attempt already exists');dest.mkdir()
+    archive=dest/'evidence.tar.gz'
+    with tarfile.open(archive,'x:gz',dereference=False) as t:t.add(folder,arcname=folder.name)
+    c.write_new(dest/'receipt.json',{'archive':binding(archive),'external_data_dereferenced':False})
+    if checkpoint:
+        plan=json.loads((folder/'plan.json').read_text());report=json.loads((folder/'execution/report.json').read_text())
+        backup=c.SESSION.parent/'checkpoints'/folder.name
+        target=REPO/'checkpoints/local-curriculum-update146'/folder.name;require(not target.exists(),'Private checkpoint exists')
+        target.parent.mkdir(parents=True,exist_ok=True);shutil.copytree(backup,target)
+        proof=verify_pair(target/'after-resume.pt',target/'after-policy.pt',plan,report)
+        require(proof['exact_model_adam_rng_progress_pool'],'Private restore failed')
+        git('add','--',str(target.relative_to(REPO)))
+    git('add','--',str(dest.relative_to(REPO)));git('commit','-m','Preserve curriculum '+label);git('push','origin','HEAD:refs/heads/codex/local365-teacher-results')
+    return git('rev-parse','HEAD')
+
+
+def run(v,parent,seq,seat,mode):
+    final=mode=='final';evaluate=mode!='training'
+    row={'sequence':seq,'seat':seat,'mode':mode,'status':'preparing','parent':binding(parent)};v['batches'].append(row);save(v)
+    plan_path=c.prepare(parent,seq,seat,evaluate,final);row['plan']=binding(plan_path);row['status']='running';save(v)
+    deadline=c.session()['absolute_deadline_unix']-15 if final else c.session()['compute_deadline_unix']
+    with (c.SESSION.parent/f'{plan_path.parent.name}.log').open('x') as log:
+        proc=subprocess.run([sys.executable,'-m','experiments.learner.curriculum_training','execute','--plan',str(plan_path),'--sha256',row['plan']['sha256']],cwd=ROOT,stdout=log,stderr=subprocess.STDOUT,timeout=max(1,deadline-time.time()))
+    report_path=plan_path.parent/'execution/report.json';report=json.loads(report_path.read_text());row['report']=binding(report_path)
+    row['completed_games']=sum(a['status']=='passed' for a in report['attempts']);row['outcomes']=[a['outcomes'][('red','blue')[seat]] for a in report['attempts']]
+    row['optimizer_steps']=report['optimizer_steps'];row['training_samples']=report['training_samples']
+    ok=proc.returncode==0 and report['status']=='finished' and report['worker_complete'] and report['supervisor_cleanup_verified'] and report['within_shared_budget']
+    row['status']='verified' if ok else 'failed';save(v)
+    if ok and not evaluate:
+        backup=c.SESSION.parent/'checkpoints'/plan_path.parent.name;plan=json.loads(plan_path.read_text())
+        proof=verify_pair(backup/'after-resume.pt',backup/'after-policy.pt',plan,report)
+        v['latest_verified_parent']=binding(plan_path);v['latest_progress']=proof['progress'];v['new_updates']+=1;save(v)
+    row['private_commit']=publish(plan_path.parent,plan_path.parent.name,checkpoint=ok and not evaluate)
+    if ok and not evaluate:v['latest_private_parent']=binding(plan_path)
+    row['status']='passed' if ok else 'failed';save(v)
+    require(ok,'Technical failure; no retry or additional gameplay')
+    return plan_path if not evaluate else parent
+
+
+def worker():
+    s=c.session();require(os.getppid()==s['controller_pid'],'Wrong supervisor')
+    with (c.SESSION.parent/'worker.lock').open('x') as f:f.write(str(os.getpid()))
+    parent=c.PARENT;v={'status':'running','batches':[],'new_updates':0,'latest_verified_parent':binding(parent),'latest_private_parent':binding(parent),'latest_progress':{'updates':146,'rollouts':584,'decisions':40641}}
+    save(v);durations=[120.];seq=0
+    try:
+        for seat in (0,1):run(v,parent,146,seat,'baseline')
+        while True:
+            s=c.session()
+            if min(s['compute_deadline_unix']-time.time(),s['started_monotonic']+6900-time.monotonic()) < max(300,2*max(durations[-5:])+120):break
+            started=time.monotonic();parent=run(v,parent,seq,seq%2,'training');seq+=1;durations.append(time.monotonic()-started)
+            if v['new_updates']%5==0:
+                for seat in (0,1):run(v,parent,v['latest_progress']['updates'],seat,'periodic')
+        for seat in (0,1):run(v,parent,v['latest_progress']['updates'],seat,'final')
+        v['status']='finished_budget_reserve'
+    except Exception as error:
+        v.update(status='stopped_failure',error=f'{type(error).__name__}: {error}')
+    finally:
+        v['stopped_unix']=time.time();save(v)
+
+
+def prepare_release():
+    require(not c.SESSION.exists(),'Consumed campaign cannot restart')
+    counts=c.check_gate(c.BASE/'study2/study-report.json');state=c.restore(c.PARENT)
+    require(vars(state.progress)=={'updates':146,'rollouts':584,'decisions':40641} and state.optimizer_steps==1475,'Wrong initial progress')
+    runtime_bin='/Users/orsi/Projects/Heroes-artifacts/runtime/local-v8-update92-artifact-fix2/bin'
+    source=source_identity(c.INTERFACE);require(not source['tracked_worktree_dirty'],'Commit preparation before release')
+    original=json.loads(c.PARENT.read_text());runtime=runtime_identity(Path(runtime_bin));require(runtime==original['runtime'],'Runtime changed')
+    release={'scope':c.SCOPE,'authorization':'User authorized fresh two-hour local curriculum campaign after mixed natural outcomes; no diagnostics admitted.',
+        'source':source,'configuration':c.configuration(),'parent':state.bindings,'runtime_bin':runtime_bin,'runtime':runtime,
+        'data':'/Users/orsi/Projects/Heroes-artifacts/game-data','gate':binding(c.BASE/'study2/study-report.json'),'validation_outcomes':counts,
+        'maps':[c.map_identity(c.BASE/f'maps/curriculum-3-{s}.vmap',s) for s in (0,1)],
+        'distribution':'Alternating four-game same-seat batches; same open8x8 state, no transition to harder stages in this campaign',
+        'heldout':{'seats':[0,1],'engine_seeds':[710001,710002,710003,710004],'policy_seeds':[720001,720002,720003,720004]},
+        'whole_wall_seconds':7200,'finalization_reserve_seconds':300,'diagnostic_admission':False}
+    path=c.BASE/'campaign-v1/release.json';c.write_new(path,release);print(json.dumps(binding(path)))
+
+
+def launch():
+    private_preflight();path=c.BASE/'campaign-v1/release.json';r=json.loads(path.read_text())
+    require(r['source']==source_identity(c.INTERFACE) and not r['source']['tracked_worktree_dirty'],'Release source drift')
+    require(binding(r['gate']['path'])==r['gate'] and c.check_gate(r['gate']['path'])==r['validation_outcomes'],'Gate drift')
+    require(c.restore(c.PARENT).bindings==r['parent'],'Exact initial state changed')
+    require(runtime_identity(Path(r['runtime_bin']))==r['runtime'],'Runtime changed')
+    require([c.map_identity(c.BASE/f'maps/curriculum-3-{s}.vmap',s) for s in (0,1)]==r['maps'],'Map changed')
+    require(not c.SESSION.exists(),'One campaign only')
+    with c.SESSION.with_suffix('.lock').open('x') as f:f.write(str(os.getpid()))
+    now=time.time();mono=time.monotonic();s={'scope':c.SCOPE,'source':r['source'],'runtime':r['runtime'],'release':binding(path),
+        'started_unix':now,'started_monotonic':mono,'compute_deadline_unix':now+6900,'absolute_deadline_unix':now+7200,
+        'controller_pid':os.getpid(),'validation_outcomes':r['validation_outcomes']}
