+bool CClient::recordBuiltinNativeTerminal(PlayerColor player, bool won)
+{
+	const int learner = experimentBuiltinLearner();
+	if(learner < 0 || (player != PlayerColor(0) && player != PlayerColor(1))
+		|| !builtinNativeTerminalOutcomes.emplace(player, won).second)
+		throw std::runtime_error("Unexpected or repeated built-in evaluation terminal callback");
+	if(player == PlayerColor(learner))
+		recordExplorerTerminal(player, won);
+	logAi->info("Experiment native player %d %s. Terminal callbacks complete.", player.getNum(), won ? "won" : "lost");
+	return builtinNativeTerminalOutcomes.size() == 2;
