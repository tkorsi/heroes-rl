+int experimentBuiltinLearner()
+{
+	const char * opponent = std::getenv("EXPLORER_RL_BUILTIN_OPPONENT");
+	if(!opponent)
+		return -1;
+	const char * players = std::getenv("EXPLORER_RL_PLAYERS");
+	const char * interface = std::getenv("EXPLORER_RL_INTERFACE");
+	if(std::string(opponent) != "Nullkiller" || !contextualEvidenceEnabled()
+		|| !interface || std::string(interface) != "adventure-dialogs-v1"
+		|| std::getenv("EXPLORER_RL_PLAYER") || !players
+		|| (std::string(players) != "0" && std::string(players) != "1"))
+		throw std::runtime_error("Built-in evaluation requires one explicit v7 ExplorerRL seat and Nullkiller");
+	return players[0] - '0';
+}
+
+JsonNode experimentBuiltinControllers()
+{
+	JsonNode result;
+	const int learner = experimentBuiltinLearner();
+	if(learner < 0)
+		return result;
+	result["schema"].String() = "heroes-contextual-controllers-v1";
+	result["explorer_players"].Vector().emplace_back(learner);
+	JsonNode opponent;
+	opponent["player"].Integer() = 1 - learner;
+	opponent["module"].String() = "Nullkiller";
+	result["native_opponents"].Vector().push_back(opponent);
+	return result;
+}
