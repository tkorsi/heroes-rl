+std::vector<std::pair<const char *, uint64_t>> stateDigestParts(CGameHandler & gameHandler)
+{
+	std::vector<std::pair<const char *, uint64_t>> parts;
+	DigestWriter writer;
+	BinarySerializer serializer(&writer);
+	serializer & gameHandler.gameState();
+	parts.emplace_back("game_state", writer.state);
+	addHandlerParts(gameHandler, parts);
 	return parts;
 }
 
+uint64_t stateDigestWithParts(CGameHandler & gameHandler, std::vector<std::pair<const char *, uint64_t>> & parts)
+{
+	parts.clear();
+	DigestWriter writer;
+	BinarySerializer serializer(&writer);
+	serializer & gameHandler.gameState();
+	// Until here this is exactly the fresh serializer and digest of the game_state part.
+	parts.emplace_back("game_state", writer.state);
+	serializer & gameHandler.QID;
+	serializer & gameHandler.uiReadyForDialogs;
+	serializer & *gameHandler.randomizer;
+	serializer & *gameHandler.battles;
+	serializer & *gameHandler.heroPool;
+	serializer & *gameHandler.playerMessages;
+	serializer & *gameHandler.turnOrder;
+	serializer & *gameHandler.turnTimerHandler;
+	addHandlerParts(gameHandler, parts);
+	return writer.state;
+}
