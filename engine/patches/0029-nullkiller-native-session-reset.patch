+/// Native-session host only, after every AIGateway and worker task of the
+/// previous game is gone: release module-level caches, so the next embedded
+/// game starts from the same module state as a newly launched client.
+extern "C" DLL_EXPORT void ResetNativeSessionState()
+{
+	NKAI::Nullkiller::baseGraph.reset();
+	NKAI::AIPathfinder::resetNativeSession();
+	NKAI::AISharedStorage::resetNativeSession();
+}
