+bool CDynLibHandler::resetExperimentModule(const std::string & dllname)
+{
+#if defined(STATIC_AI) || defined(VCMI_WINDOWS)
+	return false;
+#else
+	using TResetFun = void (*)();
+	const boost::filesystem::path filePath = VCMIDirs::get().fullLibraryPath("AI", dllname);
+	// Same handle as the loader's own never-closed reference; this one is closed again.
+	void * dll = dlopen(filePath.string().c_str(), RTLD_LOCAL | RTLD_LAZY);
+	if(!dll)
+		throw std::runtime_error("Cannot open dynamic library for native reset: " + filePath.string());
+	const auto reset = reinterpret_cast<TResetFun>(dlsym(dll, "ResetNativeSessionState"));
+	if(reset)
+		reset();
+	dlclose(dll);
+	return reset != nullptr;
+#endif
+}
