+std::vector<PlayerColor> CPlayerInterface::getRequestedRecordingPlayers()
+{
+	std::vector<PlayerColor> players;
+	const char * value = std::getenv("VCMI_RECORD_PLAYERS");
+	if(!value)
+		return players;
+	for(const char * cursor = value;; cursor += 2)
+	{
+		if(*cursor < '0' || *cursor >= '0' + PlayerColor::PLAYER_LIMIT_I)
+			throw std::runtime_error("VCMI_RECORD_PLAYERS must be unique player indices from 0 to 7 separated by commas");
+		const PlayerColor player(*cursor - '0');
+		if(vstd::contains(players, player))
+			throw std::runtime_error("VCMI_RECORD_PLAYERS must not contain duplicate players");
+		players.push_back(player);
+		if(cursor[1] == '\0')
+			return players;
+		if(cursor[1] != ',')
+			throw std::runtime_error("VCMI_RECORD_PLAYERS must be unique player indices from 0 to 7 separated by commas");
+	}
+}
+
 bool CPlayerInterface::hasRecordingPerspective() const
 {
 	return recordingPlayer.has_value();
