+void CPlayerInterface::setRecordingPlayer(PlayerColor player)
+{
+	if(!playerID.isSpectator() || !player.isValidPlayer() || !cb->getPlayerState(player, false))
+		throw std::runtime_error("Recording perspective requires an observer and a player present in the game");
+	if(recordingPlayer != player)
+	{
+		recordingPlayer = player;
+		++recordingPerspectiveRevision;
+	}
 }
 
