+/// Opt-in experiment capture of the game surface, before window scaling and cursor rendering.
+class ScreenHandler::FrameRecorder
+{
+	using Clock = std::chrono::steady_clock;
+	using File = std::unique_ptr<std::FILE, decltype(&std::fclose)>;
+
+	boost::filesystem::path directory;
+	File manifest{nullptr, &std::fclose};
+	Clock::time_point started;
+	Clock::time_point nextFrame;
+	std::chrono::duration<double> interval;
+	unsigned int maxFrames = 0;
+	unsigned int frameCount = 0;
+	bool stopped = false;
+
+	static unsigned int readSetting(const char * name, unsigned int fallback, unsigned int maximum)
+	{
+		const char * value = std::getenv(name);
+		if(!value)
+			return fallback;
+
+		unsigned int result = 0;
+		for(const char * digit = value; *digit; ++digit)
+		{
+			if(*digit < '0' || *digit > '9' || result > (maximum - (*digit - '0')) / 10)
+				throw std::runtime_error(std::string(name) + " must be an integer from 1 to " + std::to_string(maximum));
+			result = result * 10 + (*digit - '0');
+		}
+		if(result == 0 || result > maximum)
+			throw std::runtime_error(std::string(name) + " must be an integer from 1 to " + std::to_string(maximum));
+		return result;
+	}
+
+	static File createFile(const boost::filesystem::path & path)
+	{
+		// Exclusive creation prevents overwriting another run, including after initialization.
+		File file(std::fopen(path.string().c_str(), "wbx"), &std::fclose);
+		if(!file)
+			throw std::runtime_error("Cannot exclusively create recording file: " + path.string());
+		return file;
+	}
+
+	static void writeText(std::FILE * file, const std::string & text)
+	{
+		if(std::fwrite(text.data(), 1, text.size(), file) != text.size() || std::fflush(file) != 0)
+			throw std::runtime_error("Cannot write recording metadata");
+	}
+
+	void reportError(const std::string & message)
+	{
+		stopped = true;
+		logGlobal->error("Experiment recording failed: %s", message);
+		try
+		{
+			// Before exclusive manifest creation this directory may belong to a previous run.
+			// Do not add an error marker that would invalidate that run's existing evidence.
+			if(manifest && directory.is_absolute() && boost::filesystem::is_directory(directory))
+			{
+				auto errorFile = createFile(directory / "recording-error.txt");
+				writeText(errorFile.get(), message + "\n");
+			}
+		}
+		catch(const std::exception & error)
+		{
+			logGlobal->error("Cannot write recording error marker: %s", error.what());
+		}
+	}
+
+public:
+	explicit FrameRecorder(const char * outputDirectory)
+		: directory(outputDirectory)
+	{
+		try
+		{
+			if(directory.empty() || !directory.is_absolute())
+				throw std::runtime_error("VCMI_RECORD_DIR must be an absolute directory path");
+			boost::filesystem::create_directories(directory);
+			for(const auto & entry : boost::filesystem::directory_iterator(directory))
+			{
+				const auto name = entry.path().filename().string();
+				if(name == "frames.jsonl" || name.rfind("recording-", 0) == 0 || (name.rfind("frame", 0) == 0 && entry.path().extension() == ".png"))
+					throw std::runtime_error("Recording directory contains previous output: " + entry.path().string());
+			}
+			interval = std::chrono::duration<double>(1.0 / readSetting("VCMI_RECORD_FPS", 6, 60));
+			maxFrames = readSetting("VCMI_RECORD_MAX_FRAMES", 3600, 1000000);
+			manifest = createFile(directory / "frames.jsonl");
+			logGlobal->info("Experiment recording enabled: %s (maximum %u frames)", directory.string(), maxFrames);
+		}
+		catch(const std::exception & error)
+		{
+			reportError(error.what());
+			throw;
+		}
+	}
+
+	void capture(SDL_Surface * surface)
+	{
+		if(stopped)
+			return;
+		const auto now = Clock::now();
+		if(frameCount && now < nextFrame)
+			return;
+
+		try
+		{
+			if(!frameCount)
+				started = now;
+			std::ostringstream filename;
+			filename.imbue(std::locale::classic());
+			filename << "frame" << std::setfill('0') << std::setw(6) << frameCount + 1 << ".png";
+			auto file = createFile(directory / filename.str());
+			SDL_RWops * output = SDL_RWFromFP(file.get(), SDL_FALSE);
+			if(!output)
+				throw std::runtime_error(std::string("Cannot open PNG output: ") + SDL_GetError());
+			if(IMG_SavePNG_RW(surface, output, 1) != 0)
+				throw std::runtime_error(std::string("Cannot save PNG frame: ") + IMG_GetError());
+			if(std::fflush(file.get()) != 0)
+				throw std::runtime_error("Cannot flush PNG frame");
+
+			std::ostringstream metadata;
+			metadata.imbue(std::locale::classic());
+			metadata << "{\"index\":" << frameCount + 1
+				<< ",\"file\":\"" << filename.str() << "\",\"elapsed_seconds\":"
+				<< std::fixed << std::setprecision(6) << std::chrono::duration<double>(now - started).count()
+				<< ",\"width\":" << surface->w << ",\"height\":" << surface->h << "}\n";
+			writeText(manifest.get(), metadata.str());
+			++frameCount;
+			// Do not synthesize catch-up frames if PNG encoding or gameplay took longer than the interval.
+			nextFrame = now + std::chrono::duration_cast<Clock::duration>(interval);
+			if(frameCount == maxFrames)
+			{
+				auto limitFile = createFile(directory / "recording-limit-reached.txt");
+				writeText(limitFile.get(), std::to_string(frameCount) + "\n");
+				stopped = true;
+				logGlobal->info("Experiment recording reached frame limit: %u", frameCount);
+			}
+		}
+		catch(const std::exception & error)
+		{
+			reportError(error.what());
+		}
+	}
+};
