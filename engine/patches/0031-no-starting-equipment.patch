+
+	// All heroes obey the ongoing artifact ban. Remove the final random
+	// starting artifacts after preserving ordinary bonus draws and resources.
+	// Native removal also detaches equipped bonuses and handles combined artifacts.
+	const auto & equipmentPolicy = settings["server"]["experimentEquipmentPolicy"];
+	if(!equipmentPolicy.isNull() && (!equipmentPolicy.isString()
+		|| (equipmentPolicy.String() != "native" && equipmentPolicy.String() != "no-artifacts-v1")))
+		throw std::runtime_error("Unsupported experimentEquipmentPolicy policy");
+	if(equipmentPolicy.isString() && equipmentPolicy.String() == "no-artifacts-v1")
+	{
+		if(scenarioOps->mode != EStartMode::NEW_GAME)
+			throw std::runtime_error("no-artifacts-v1 requires a new single scenario");
+		for(const auto heroID : map->getHeroesOnMap())
+		{
+			auto hero = getHero(heroID);
+			std::vector<ArtifactPosition> worn;
+			for(const auto & [slot, info] : hero->artifactsWorn)
+				if(!info.locked)
+					worn.push_back(slot);
+			int removed = 0;
+			for(const auto & slot : worn)
+				if(hero->getArt(slot))
+				{
+					map->removeArtifactInstance(*hero, slot);
+					++removed;
+				}
+			while(!hero->artifactsInBackpack.empty())
+			{
+				map->removeArtifactInstance(*hero, ArtifactPosition::BACKPACK_START);
+				++removed;
+			}
+			if(hero->getArt(ArtifactPosition::TRANSITION_POS))
+			{
+				map->removeArtifactInstance(*hero, ArtifactPosition::TRANSITION_POS);
+				++removed;
+			}
+			if(!hero->artifactsWorn.empty() || !hero->artifactsInBackpack.empty())
+				throw std::runtime_error("Starting equipment removal left occupied slots");
+			// Recompute army morale and opening caches after equipment bonuses disappear.
+			if(removed)
+			{
+				hero->armyChanged();
+				hero->setMovementPoints(hero->movementPointsLimit(true));
+				hero->mana = hero->manaLimit();
+			}
+			const auto playerInfo = scenarioOps->playerInfos.find(hero->getOwner());
+			logGlobal->info("Equipment policy no-artifacts-v1: player=%d hero=%d resolved_bonus=%d removed_items=%d",
+				hero->getOwner().getNum(), hero->id.getNum(),
+				playerInfo != scenarioOps->playerInfos.end() ? static_cast<int>(playerInfo->second.bonus) : -1, removed);
+		}
+	}
 	initTowns(randomGenerator);
 	initTownNames(randomGenerator);
 	placeHeroesInTowns();
