+ExperimentEventGuard::ExperimentEventGuard(const char * actor_, const char * operation_)
+	: actor(actor_), operation(operation_), enabled(contextualEvidenceEnabled())
+{
+	if(!enabled)
+		return;
+	if(eventDepth)
+	{
+		++eventDepth;
+		return;
+	}
+	hooks = experimentEvidenceHooks();
+	if(hooks)
+		hooks->beforeEvent(actor, operation);
+	lock = std::unique_lock<std::recursive_mutex>(experimentEventMutex);
+	eventDepth = 1;
+	eventActor = actor;
+	outermost = true;
+	try
+	{
+		if(hooks)
+			hooks->eventEntered(actor, operation);
+	}
+	catch(...)
+	{
+		eventDepth = 0;
+		eventActor.clear();
+		throw;
+	}
+}
+
+ExperimentEventGuard::~ExperimentEventGuard() noexcept
+{
+	if(!enabled)
+		return;
+	if(outermost)
+	{
+		try
+		{
+			if(hooks)
+				hooks->eventLeaving(actor, operation);
+		}
+		catch(const std::exception & error)
+		{
+			reportExperimentFailure(std::string("Contextual evidence transaction failed: ") + error.what());
+		}
+		catch(...)
+		{
+			reportExperimentFailure("Contextual evidence transaction failed");
+		}
+		eventActor.clear();
+	}
+	--eventDepth;
+}
+
+void beginExperimentPacket(uint16_t type)
+{
+	if(!contextualEvidenceEnabled())
+		return;
+	if(!eventDepth || receiptPosition.index != receiptPosition.completed)
+		throw std::runtime_error("Contextual client packet receipt is incomplete");
+	++receiptPosition.index;
+	receiptPosition.type = type;
+	receiptPosition.phase = ExperimentPacketPhase::Before;
+}
+
+void noteExperimentPacketCallbacksComplete()
+{
+	if(!contextualEvidenceEnabled())
+		return;
+	if(!eventDepth || receiptPosition.phase != ExperimentPacketPhase::Applied)
+		throw std::runtime_error("Contextual packet callbacks completed out of order");
+	receiptPosition.phase = ExperimentPacketPhase::CallbacksComplete;
+	receiptPosition.completed = receiptPosition.index;
+}
+
+ExperimentReceiptPosition experimentReceiptPosition()
+{
+	std::lock_guard lock(experimentEventMutex);
+	return receiptPosition;
+}
+
+void writeExperimentTerminalBarrier(const ExperimentTerminalBarrier & barrier, bool client)
+{
+	const char * directory = std::getenv("VCMI_EXPERIMENT_DIR");
+	if(!directory || !*directory || experimentHasFailed())
+		throw std::runtime_error("Contextual terminal barrier evidence unavailable");
+	JsonNode record;
+	record["schema"].String() = "heroes-contextual-terminal-barrier-v1";
+	record["kind"].String() = client ? "client" : "server";
+	record["episode"].String() = barrier.episode;
+	record["interface"].String() = barrier.interface;
+	record["barrier_id"].Integer() = barrier.barrierId;
+	record["origin"].String() = "request";
+	record["request"]["player"].Integer() = barrier.requestPlayer.getNum();
+	record["request"]["id"].Integer() = barrier.requestID;
+	record["request"]["type"].Integer() = barrier.requestType;
+	record["client_packets"].Integer() = barrier.clientPackets;
+	record["outcomes"].Vector() = {JsonNode(barrier.redWon ? "win" : "loss"), JsonNode(barrier.redWon ? "loss" : "win")};
+	if(client)
+	{
+		record["callbacks_complete"].Bool() = true;
+		record["observed_count"].Integer() = experimentReceiptPosition().completed;
+	}
+	std::string line = record.toCompactString();
+	line.erase(std::remove(line.begin(), line.end(), '\n'), line.end());
+	line.erase(std::remove(line.begin(), line.end(), '\r'), line.end());
+	line += '\n';
+	const std::string path = std::string(directory) + "/terminal-barrier-" + (client ? "client" : "server") + ".jsonl";
+	FILE * output = std::fopen(path.c_str(), "wbx");
+	if(!output)
+		throw std::runtime_error("Cannot create contextual terminal barrier evidence");
+	const bool written = std::fwrite(line.data(), 1, line.size(), output) == line.size();
+	const bool flushed = std::fflush(output) == 0;
+	const bool closed = std::fclose(output) == 0;
+	if(!written || !flushed || !closed)
+		throw std::runtime_error("Cannot flush contextual terminal barrier evidence");
 }
 
