+bool CGameHandler::contextualNaturalEnd() const
+{
+	if(!contextualEvidenceEnabled())
+		return false;
+	const auto red = gameState().players.find(PlayerColor(0));
+	const auto blue = gameState().players.find(PlayerColor(1));
+	if(gameState().players.size() != 2 || red == gameState().players.end() || blue == gameState().players.end())
+		throw std::runtime_error("Contextual terminal barrier requires exactly Red and Blue");
+	return (red->second.status == EPlayerStatus::WINNER && blue->second.status == EPlayerStatus::LOSER)
+		|| (red->second.status == EPlayerStatus::LOSER && blue->second.status == EPlayerStatus::WINNER);
