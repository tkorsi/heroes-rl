+std::optional<PlayerColor> CClient::configuredExplorerPlayer() const
+{
+	const char * configured = std::getenv("EXPLORER_RL_PLAYER");
+	if(!configured)
+		return std::nullopt;
+	if(configured[0] < '0' || configured[0] > '7' || configured[1] != '\0')
+		throw std::runtime_error("EXPLORER_RL_PLAYER must be exactly one player index from 0 to 7");
+	return PlayerColor(configured[0] - '0');
