+void Recorder::afterInit(CGameHandler & gameHandler, int seed, const char * noCheats)
+{
+	std::string connections = "[";
+	for(int connection = static_cast<int>(GameConnectionID::FIRST_CONNECTION); connection < 32; ++connection)
+	{
+		std::string players;
+		for(const int player : PLAYER_IDS)
+			if(gameHandler.gameServer().hasPlayerAt(PlayerColor(player), GameConnectionID(connection)))
+				players += (players.empty() ? "" : ",") + std::to_string(player);
+		if(players.empty())
+			continue;
+		if(clientConnection < 0)
+			clientConnection = connection;
+		connections += (connections.size() > 1 ? "," : "") + std::string("{\"id\":") + std::to_string(connection) + ",\"players\":[" + players + "]}";
+	}
+	connections += "]";
+	std::string hosts;
+	for(const int player : PLAYER_IDS)
+		if(gameHandler.gameServer().isPlayerHost(PlayerColor(player)))
+			hosts += (hosts.empty() ? "" : ",") + std::to_string(player);
+	const auto * start = gameHandler.gameState().getStartInfo();
+	// CVCMIServer greets two or more human players with packs sent outside the
+	// game handler; the replay refuses such games instead of missing them.
+	int humans = 0;
+	for(const auto & player : start->playerInfos)
+		humans += player.second.isControlledByHuman();
+	line(std::string("{\"kind\":\"init\",\"schema\":\"") + SCHEMA + "\",\"vcmi_version\":" + quoted(GameConstants::VCMI_VERSION)
+		+ ",\"serialization_version\":" + std::to_string(static_cast<int>(ESerializationVersion::CURRENT))
+		+ ",\"platform\":" + quoted(platform()) + ",\"seed\":" + std::to_string(seed)
+		+ ",\"no_cheats\":" + (noCheats ? quoted(noCheats) : std::string("null"))
+		+ ",\"turn_timers\":" + (start->turnTimerInfo.isEnabled() ? "true" : "false") + ",\"human_players\":" + std::to_string(humans)
+		+ ",\"map\":" + quoted(start->fileURI) + ",\"connections\":" + connections
+		+ ",\"client_connection\":" + std::to_string(clientConnection) + ",\"hosts\":[" + hosts + "]"
+		+ ",\"start_info\":\"" + toHex(startInfo) + "\",\"digest\":\"" + digestHex(stateDigest(gameHandler)) + "\""
+		+ ",\"parts\":" + partsJson(gameHandler) + "}");
+}
+
+void Recorder::afterStart(CGameHandler & gameHandler, IGameServer &)
+{
+	line("{\"kind\":\"start\",\"out\":" + std::to_string(outgoing.count) + ",\"client_out\":" + std::to_string(outgoing.clientCount)
+		+ ",\"chain\":\"" + digestHex(outgoing.chain) + "\",\"digest\":\"" + digestHex(stateDigest(gameHandler)) + "\""
+		+ ",\"parts\":" + partsJson(gameHandler) + ",\"sent\":" + sentJson(outgoing) + "}");
+	outgoing.clearFlags();
+}
+
+void Recorder::input(GameConnectionID connection, const CPackForServer & pack)
+{
+	outgoing.clearFlags();
+	line("{\"kind\":\"input\",\"seq\":" + std::to_string(sequence) + ",\"connection\":" + std::to_string(static_cast<int>(connection))
+		+ ",\"player\":" + std::to_string(pack.player.getNum()) + ",\"request\":" + std::to_string(pack.requestID)
+		+ ",\"type\":" + std::to_string(CTypeList::getInstance().getTypeID(&pack)) + ",\"out\":" + std::to_string(outgoing.count)
+		+ ",\"pack\":\"" + toHex(encodePack(pack)) + "\"}");
+}
+
+void Recorder::applied(CGameHandler & gameHandler, const CPackForServer & pack, bool blocked, bool result)
+{
+	const char * boundary = boundaryAfter(pack, result, outgoing);
+	std::string terminals = "[";
+	for(const auto & [player, victory] : outgoing.terminals)
+		terminals += (terminals.size() > 1 ? "," : "") + std::string("{\"player\":") + std::to_string(player) + ",\"victory\":" + (victory ? "true" : "false") + "}";
+	terminals += "]";
+	line("{\"kind\":\"applied\",\"seq\":" + std::to_string(sequence) + ",\"blocked\":" + (blocked ? "true" : "false")
+		+ ",\"result\":" + (result ? "true" : "false") + ",\"out\":" + std::to_string(outgoing.count)
+		+ ",\"client_out\":" + std::to_string(outgoing.clientCount) + ",\"chain\":\"" + digestHex(outgoing.chain) + "\""
+		+ ",\"boundary\":" + (boundary ? quoted(boundary) : std::string("null"))
+		+ ",\"digest\":" + (boundary ? "\"" + digestHex(stateDigest(gameHandler)) + "\"" : std::string("null"))
+		+ ",\"parts\":" + (boundary ? partsJson(gameHandler) : std::string("null"))
+		+ ",\"sent\":" + sentJson(outgoing) + ",\"terminals\":" + terminals + "}");
+	++sequence;
+}
+
+void Recorder::sent(const CPackForClient & pack, int target)
+{
+	outgoing.note(pack, target, clientConnection);
+}
+}
