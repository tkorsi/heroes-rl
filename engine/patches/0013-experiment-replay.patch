+class BufferWriter final : public IBinaryWriter
+{
+public:
+	std::vector<std::byte> buffer;
+
+	int write(const std::byte * data, unsigned size) override
+	{
+		buffer.insert(buffer.end(), data, data + size);
+		return size;
+	}
+};
+
+class BufferReader final : public IBinaryReader
+{
+	const std::vector<std::byte> & buffer;
+	size_t position = 0;
+
+public:
+	explicit BufferReader(const std::vector<std::byte> & buffer)
+		: buffer(buffer)
+	{
+	}
+
+	int read(std::byte * data, unsigned size) override
+	{
+		if(position + size > buffer.size())
+			throw std::runtime_error("Recorded bytes end early");
+		std::copy_n(buffer.begin() + position, size, data);
+		position += size;
+		return size;
+	}
+
+	bool finished() const { return position == buffer.size(); }
+};
+
+class DigestWriter final : public IBinaryWriter
+{
+public:
+	uint64_t state = DIGEST_SEED;
+
+	int write(const std::byte * data, unsigned size) override
+	{
+		for(unsigned i = 0; i < size; ++i)
+		{
+			state ^= static_cast<uint8_t>(data[i]);
+			state *= 1099511628211ULL;
+		}
+		return size;
+	}
+};
+
+uint64_t digestValue(uint64_t state, int64_t value)
+{
+	auto bits = static_cast<uint64_t>(value);
+	for(int byte = 0; byte < 8; ++byte, bits >>= 8)
+	{
+		state ^= bits & 0xff;
+		state *= 1099511628211ULL;
+	}
+	return state;
+}
+
+/// Statistics entries carry wall-clock time, which no replay can reproduce.
+void clearTimestamps(StatisticDataSet & statistics)
+{
+	for(auto & entry : statistics.data)
+		entry.timestamp = 0;
+}
+
+/// The bytes that identify a sent pack, without wall-clock fields.
+std::vector<std::byte> canonicalPack(const CPackForClient & pack)
+{
+	if(const auto * ending = dynamic_cast<const PlayerEndsGame *>(&pack))
+	{
+		auto copy = *ending;
+		clearTimestamps(copy.statistic);
+		return encodePack(copy);
+	}
+	if(const auto * response = dynamic_cast<const ResponseStatistic *>(&pack))
+	{
+		auto copy = *response;
+		clearTimestamps(copy.statistic);
+		return encodePack(copy);
+	}
+	return encodePack(pack);
+}
+}
