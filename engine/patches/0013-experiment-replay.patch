+std::vector<std::byte> encodePack(const CPack & pack)
+{
+	BufferWriter writer;
+	BinarySerializer serializer(&writer);
+	serializer & &pack;
+	return writer.buffer;
+}
+
+std::vector<std::byte> encodeStartInfo(const StartInfo & startInfo)
+{
+	BufferWriter writer;
+	BinarySerializer serializer(&writer);
+	serializer & startInfo;
+	return writer.buffer;
+}
+
+std::unique_ptr<CPack> decodePack(const std::vector<std::byte> & bytes, IGameInfoCallback * gameInfo)
+{
+	BufferReader reader(bytes);
+	BinaryDeserializer deserializer(&reader);
+	deserializer.version = ESerializationVersion::CURRENT;
+	deserializer.cb = gameInfo;
+	std::unique_ptr<CPack> pack;
+	deserializer & pack;
+	if(!pack || !reader.finished())
+		throw std::runtime_error("Recorded pack bytes do not hold exactly one pack");
+	return pack;
+}
+
+void decodeStartInfo(const std::vector<std::byte> & bytes, StartInfo & startInfo)
+{
+	BufferReader reader(bytes);
+	BinaryDeserializer deserializer(&reader);
+	deserializer.version = ESerializationVersion::CURRENT;
+	deserializer & startInfo;
+	if(!reader.finished())
+		throw std::runtime_error("Recorded StartInfo has trailing bytes");
+}
+
+std::string toHex(const std::vector<std::byte> & bytes)
+{
+	static constexpr char DIGITS[] = "0123456789abcdef";
+	std::string result;
+	result.reserve(bytes.size() * 2);
+	for(const auto byte : bytes)
+	{
+		result += DIGITS[static_cast<uint8_t>(byte) >> 4];
+		result += DIGITS[static_cast<uint8_t>(byte) & 15];
+	}
+	return result;
+}
+
+std::vector<std::byte> fromHex(const std::string & text)
+{
+	auto digit = [](char c) -> int
+	{
+		if(c >= '0' && c <= '9')
+			return c - '0';
+		if(c >= 'a' && c <= 'f')
+			return c - 'a' + 10;
+		throw std::runtime_error("Invalid hexadecimal digit in replay record");
+	};
+	if(text.size() % 2)
+		throw std::runtime_error("Odd-length hexadecimal field in replay record");
+	std::vector<std::byte> result;
+	result.reserve(text.size() / 2);
+	for(size_t i = 0; i < text.size(); i += 2)
+		result.push_back(static_cast<std::byte>(digit(text[i]) * 16 + digit(text[i + 1])));
+	return result;
+}
+
+std::string digestHex(uint64_t value)
+{
+	char buffer[17];
+	std::snprintf(buffer, sizeof(buffer), "%016llx", static_cast<unsigned long long>(value));
+	return buffer;
+}
+
+uint64_t stateDigest(CGameHandler & gameHandler)
+{
+	DigestWriter writer;
+	BinarySerializer serializer(&writer);
+	serializer & gameHandler.gameState();
+	serializer & gameHandler.QID;
+	serializer & gameHandler.uiReadyForDialogs;
+	serializer & *gameHandler.randomizer;
+	serializer & *gameHandler.battles;
+	serializer & *gameHandler.heroPool;
+	serializer & *gameHandler.playerMessages;
+	serializer & *gameHandler.turnOrder;
+	serializer & *gameHandler.turnTimerHandler;
+	return writer.state;
+}
+
+std::vector<std::pair<const char *, uint64_t>> stateDigestParts(CGameHandler & gameHandler)
+{
+	std::vector<std::pair<const char *, uint64_t>> parts;
+	auto part = [&parts](const char * name, const auto & value)
+	{
+		DigestWriter writer;
+		BinarySerializer serializer(&writer);
+		serializer & value;
+		parts.emplace_back(name, writer.state);
+	};
+	part("game_state", gameHandler.gameState());
+	part("queries", gameHandler.QID);
+	part("ui_ready_for_dialogs", gameHandler.uiReadyForDialogs);
+	part("randomizer", *gameHandler.randomizer);
+	part("battles", *gameHandler.battles);
+	part("hero_pool", *gameHandler.heroPool);
+	part("player_messages", *gameHandler.playerMessages);
+	part("turn_order", *gameHandler.turnOrder);
+	part("turn_timers", *gameHandler.turnTimerHandler);
+	return parts;
+}
+
+void Outgoing::note(const CPackForClient & pack, int target, int clientConnection)
+{
+	const auto type = CTypeList::getInstance().getTypeID(&pack);
+	const auto bytes = canonicalPack(pack);
+	sent.emplace_back(type, digestBytes(bytes, digestValue(digestValue(DIGEST_SEED, target), type)));
+	chain = digestValue(chain, target);
+	chain = digestValue(chain, type);
+	chain = digestBytes(bytes, chain);
+	++count;
+	if(target == -1 || target == clientConnection)
+		++clientCount;
+	if(dynamic_cast<const BattleResultsApplied *>(&pack))
+		battleEnded = true;
+	if(const auto * ending = dynamic_cast<const PlayerEndsGame *>(&pack))
+		terminals.emplace_back(ending->player.getNum(), ending->victoryLossCheckResult.victory());
+}
+
+void Outgoing::clearFlags()
+{
+	battleEnded = false;
+	terminals.clear();
+	sent.clear();
+}
+
+namespace
+{
+std::string sentJson(const Outgoing & outgoing)
+{
+	std::string result = "[";
+	for(const auto & [type, digest] : outgoing.sent)
+		result += (result.size() > 1 ? ",[" : "[") + std::to_string(type) + ",\"" + digestHex(digest) + "\"]";
+	return result + "]";
+}
+
+std::string partsJson(CGameHandler & gameHandler)
+{
+	std::string result = "{";
+	for(const auto & [name, digest] : stateDigestParts(gameHandler))
+		result += (result.size() > 1 ? ",\"" : "\"") + std::string(name) + "\":\"" + digestHex(digest) + "\"";
+	return result + "}";
+}
+}
+
+const char * boundaryAfter(const CPackForServer & input, bool result, const Outgoing & outgoing)
+{
+	if(!outgoing.terminals.empty())
+		return "game_end";
+	if(outgoing.battleEnded)
+		return "battle_end";
+	if(result && dynamic_cast<const EndTurn *>(&input))
+		return "end_turn";
+	return nullptr;
+}
