+/*
+ * ExperimentReplay.h, part of VCMI engine
+ *
+ * Authors: listed in file AUTHORS in main folder
+ *
+ * License: GNU General Public License v2.0 or later
+ * Full text of license available in license.txt file, in main folder
+ *
+ */
+#pragma once
+
+#include "../lib/serializer/GameConnectionID.h"
+
+VCMI_LIB_NAMESPACE_BEGIN
+struct CPack;
+struct CPackForClient;
+struct CPackForServer;
+struct StartInfo;
+class IGameInfoCallback;
+VCMI_LIB_NAMESPACE_END
+
+class CGameHandler;
+class IGameServer;
+
+/// Replay evidence for experiments. The server's logical state is a function
+/// of the build, mods, map, StartInfo, seed and the ordered packs its game
+/// handler receives. The recorder writes those inputs, a running digest of
+/// every pack the server sends and digests of its logical state at declared
+/// boundaries, so that a replay of the inputs can stop at the first divergence.
+namespace experiment_replay
+{
+constexpr uint64_t DIGEST_SEED = 1469598103934665603ULL;
+constexpr const char * SCHEMA = "heroes-replay-v1";
+
+uint64_t digestBytes(const std::vector<std::byte> & bytes, uint64_t state = DIGEST_SEED);
+/// A pack serialized on its own, independent of any connection's string table.
+std::vector<std::byte> encodePack(const CPack & pack);
+std::vector<std::byte> encodeStartInfo(const StartInfo & startInfo);
+/// Inverse of encodePack: throws unless the bytes hold exactly one pack.
+std::unique_ptr<CPack> decodePack(const std::vector<std::byte> & bytes, IGameInfoCallback * gameInfo);
+/// Inverse of encodeStartInfo: throws unless the bytes hold exactly one StartInfo.
+void decodeStartInfo(const std::vector<std::byte> & bytes, StartInfo & startInfo);
+std::string toHex(const std::vector<std::byte> & bytes);
+std::vector<std::byte> fromHex(const std::string & text);
+std::string digestHex(uint64_t value);
+/// Compiler, standard library, architecture and OS: replays are exact only on the recording platform.
+std::string platform();
+
+/// The game handler's logical state: the game state plus the handler's own
+/// serializable state. Statistics are left out because they hold wall-clock time.
+uint64_t stateDigest(CGameHandler & gameHandler);
+/// Digests of the same parts one by one, to name the part a divergence is in.
+std::vector<std::pair<const char *, uint64_t>> stateDigestParts(CGameHandler & gameHandler);
+
+/// What the server has sent since its game handler was created.
+struct Outgoing
+{
+	uint64_t count = 0; ///< packs sent to any connection
+	uint64_t clientCount = 0; ///< packs that reached the client connection hosting the players
+	uint64_t chain = DIGEST_SEED;
+	bool battleEnded = false; ///< since the last clearFlags()
+	std::vector<std::pair<uint16_t, uint64_t>> sent; ///< (type, digest) of each pack since the last clearFlags()
+	std::vector<std::pair<int, bool>> terminals; ///< (player, victory) since the last clearFlags()
+
+	/// target is a connection, or -1 for a pack sent to every connection.
+	void note(const CPackForClient & pack, int target, int clientConnection);
+	void clearFlags();
+};
+
+/// The declared boundary after an input, or nullptr: the end of a game, then
+/// of a battle, then an accepted end of turn.
+const char * boundaryAfter(const CPackForServer & input, bool result, const Outgoing & outgoing);
+
+class Recorder
+{
+	std::ofstream output;
+	Outgoing outgoing;
+	uint64_t sequence = 0;
+	int clientConnection = -1;
+	std::vector<std::byte> startInfo;
+
+	void line(const std::string & json);
+
+public:
+	explicit Recorder(const std::string & path);
+	~Recorder();
+	/// VCMI_EXPERIMENT_REPLAY=1 writes VCMI_EXPERIMENT_DIR/replay.jsonl; otherwise null.
+	static std::unique_ptr<Recorder> fromEnvironment();
+
+	void beforeInit(const StartInfo & startInfo);
+	void afterInit(CGameHandler & gameHandler, int seed, const char * noCheats);
+	void afterStart(CGameHandler & gameHandler, IGameServer & server);
+	void input(GameConnectionID connection, const CPackForServer & pack);
+	void applied(CGameHandler & gameHandler, const CPackForServer & pack, bool blocked, bool result);
+	void sent(const CPackForClient & pack, int target);
+};
+}
