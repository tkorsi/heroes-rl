+Recorder::Recorder(const std::string & path)
+	: output(path, std::ios::out | std::ios::trunc)
+{
+	if(!output)
+		throw std::runtime_error("Cannot create the replay log " + path);
+}
+
+Recorder::~Recorder()
+{
+	output.flush();
+}
+
+std::unique_ptr<Recorder> Recorder::fromEnvironment()
+{
+	const char * enabled = std::getenv("VCMI_EXPERIMENT_REPLAY");
+	if(!enabled || std::string(enabled) != "1")
+		return nullptr;
+	const char * directory = std::getenv("VCMI_EXPERIMENT_DIR");
+	if(!directory || !*directory)
+		throw std::runtime_error("VCMI_EXPERIMENT_REPLAY requires VCMI_EXPERIMENT_DIR");
+	return std::make_unique<Recorder>(std::string(directory) + "/replay.jsonl");
+}
+
+void Recorder::line(const std::string & json)
+{
+	// Flushed per record: the environment may stop the engine at any decision,
+	// and the inputs behind every observation a client sent must be on disk.
+	output << json << '\n' << std::flush;
+	if(!output)
+		throw std::runtime_error("Cannot write the replay log");
+}
+
+void Recorder::beforeInit(const StartInfo & original)
+{
+	startInfo = encodeStartInfo(original);
+}
