+/// Where a client stands in the server's pack stream. Replay verification uses
+/// it to place an AI's captures in the replayed authoritative state. It counts
+/// opponent activity too, so it belongs only in engine-side evidence.
+struct ExperimentPackPosition
+{
+	uint64_t index = 0; ///< packs this client has applied to its game state
