+std::string quoted(const std::string & text)
+{
+	std::string result = "\"";
+	for(const char c : text)
+	{
+		if(c == '"' || c == '\\')
+			result += '\\';
+		if(static_cast<unsigned char>(c) < 0x20)
+		{
+			char escape[8];
+			std::snprintf(escape, sizeof(escape), "\\u%04x", c);
+			result += escape;
+		}
+		else
+			result += c;
+	}
+	return result + "\"";
+}
