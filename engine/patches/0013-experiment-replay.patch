+uint64_t digestBytes(const std::vector<std::byte> & bytes, uint64_t state)
+{
+	for(const auto byte : bytes)
+	{
+		state ^= static_cast<uint8_t>(byte);
+		state *= 1099511628211ULL;
+	}
+	return state;
+}
