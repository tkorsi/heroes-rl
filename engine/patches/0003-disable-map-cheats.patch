+void writeExperimentMetadata(const CGameState & gameState)
+{
+	const char * recordingDirectory = std::getenv("VCMI_RECORD_DIR");
+	if(!recordingDirectory || !*recordingDirectory)
+		return;
+
+	const auto * options = gameState.getStartInfo();
+	JsonNode metadata;
+	metadata["schema_version"].Integer() = 1;
+	metadata["phase"].String() = "before_first_turn";
+	metadata["cheats_allowed"].Bool() = options->extraOptionsInfo.cheatsAllowed;
+	metadata["difficulty_index"].Integer() = options->difficulty;
+	metadata["map_uri"].String() = options->mapname;
+	metadata["map_name"].String() = gameState.getMap().name.toString();
+	metadata["game_day"].Integer() = gameState.day;
+	if(const char * noCheats = std::getenv("VCMI_EXPERIMENT_NO_CHEATS"))
+	{
+		if(std::string(noCheats) != "0" && std::string(noCheats) != "1")
+			throw std::runtime_error("VCMI_EXPERIMENT_NO_CHEATS must be exactly 0 or 1");
+		metadata["requested_no_cheats"].Bool() = std::string(noCheats) == "1";
+		if(metadata["requested_no_cheats"].Bool() && options->extraOptionsInfo.cheatsAllowed)
+			throw std::runtime_error("Experiment requested disabled cheats, but the actual game permits cheats");
+	}
+	else
+		metadata["requested_no_cheats"] = JsonNode();
+
+	const auto mapSize = gameState.getMapSize();
+	metadata["map_width"].Integer() = mapSize.x;
+	metadata["map_height"].Integer() = mapSize.y;
+	metadata["map_levels"].Integer() = mapSize.z;
+	for(const auto & [color, player] : gameState.players)
+	{
+		const auto & fog = gameState.teams.at(player.team).fogOfWarMap;
+		JsonNode state;
+		state["player_index"].Integer() = color.getNum();
+		state["team_index"].Integer() = player.team.getNum();
+		state["human"].Bool() = player.isHuman();
+		state["visible_tiles"].Integer() = std::count_if(fog.begin(), fog.end(), [](uint8_t visible) { return visible != 0; });
+		state["total_tiles"].Integer() = std::distance(fog.begin(), fog.end());
+		logGlobal->info("Experiment initial visibility: player=%d team=%d visible_tiles=%d total_tiles=%d",
+			color.getNum(), player.team.getNum(), state["visible_tiles"].Integer(), state["total_tiles"].Integer());
+		metadata["players"].Vector().push_back(std::move(state));
+	}
+	const auto path = boost::filesystem::path(recordingDirectory) / "experiment-metadata.json";
+	std::unique_ptr<std::FILE, decltype(&std::fclose)> file(std::fopen(path.string().c_str(), "wbx"), &std::fclose);
+	if(!file)
+		throw std::runtime_error("Cannot exclusively create experiment metadata: " + path.string());
+	const auto text = metadata.toString() + "\n";
+	if(std::fwrite(text.data(), 1, text.size(), file.get()) != text.size() || std::fflush(file.get()) != 0)
+		throw std::runtime_error("Cannot write experiment metadata: " + path.string());
+	logGlobal->info("Experiment effective state: cheats_allowed=%d difficulty=%d map=%s",
+		options->extraOptionsInfo.cheatsAllowed, static_cast<int>(options->difficulty), options->mapname);
+}
+}
 
