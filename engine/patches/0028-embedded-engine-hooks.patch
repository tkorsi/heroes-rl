+namespace
+{
+std::mutex experimentOpponentMutex;
+ExperimentOpponentProvider experimentOpponentProvider;
+std::mutex experimentObserverMutex;
+std::shared_ptr<const std::function<void(const CPackForClient &)>> experimentPacketObserver;
+std::atomic<bool> experimentServerFailures{false};
+}
+
+void setExperimentServerFailureCapture(bool enabled) noexcept
+{
+	experimentServerFailures = enabled;
+}
+
+bool experimentServerFailureCapture() noexcept
+{
+	return experimentServerFailures;
+}
+
+std::shared_ptr<CGlobalAI> CDynLibHandler::getExperimentOpponent(const std::string & dllname, int player)
+{
+	ExperimentOpponentProvider provider;
+	{
+		std::lock_guard lock(experimentOpponentMutex);
+		provider = experimentOpponentProvider;
+	}
+	if(!provider)
+		return getNewAI(dllname);
+	auto result = provider(dllname, player);
+	if(!result)
+		throw std::runtime_error("Native opponent provider returned no interface");
+	return result;
+}
+
+void CDynLibHandler::setExperimentOpponentProvider(ExperimentOpponentProvider provider)
+{
+	std::lock_guard lock(experimentOpponentMutex);
+	experimentOpponentProvider = std::move(provider);
+}
+
+void setExperimentPacketObserver(std::function<void(const CPackForClient &)> observer)
+{
+	std::lock_guard lock(experimentObserverMutex);
+	experimentPacketObserver = observer ? std::make_shared<const std::function<void(const CPackForClient &)>>(std::move(observer)) : nullptr;
+}
+
+void notifyExperimentPacketObserver(const CPackForClient & pack) noexcept
+{
+	std::shared_ptr<const std::function<void(const CPackForClient &)>> observer;
+	{
+		std::lock_guard lock(experimentObserverMutex);
+		observer = experimentPacketObserver;
+	}
+	if(!observer)
+		return;
+	try
+	{
+		(*observer)(pack);
+	}
+	catch(const std::exception & error)
+	{
+		reportExperimentFailure(std::string("Native packet observer failed: ") + error.what());
+	}
+	catch(...)
+	{
+		reportExperimentFailure("Native packet observer failed");
+	}
+}
