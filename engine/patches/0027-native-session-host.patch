+void resetNativeSessionEvidence()
+{
+	std::lock_guard eventLock(experimentEventMutex);
+	std::lock_guard hooksLock(experimentHooksMutex);
+	if(eventDepth || evidenceHooks)
+		throw std::logic_error("Native evidence reset requires quiescent detached episode hooks");
+	experimentFailure.store(false, std::memory_order_release);
+	experimentPackIndex.store(0, std::memory_order_relaxed);
+	experimentPackType.store(0, std::memory_order_relaxed);
