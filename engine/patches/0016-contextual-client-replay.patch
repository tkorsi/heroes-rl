+void CClient::initExperimentReplay(std::shared_ptr<CGameState> state,
+	const std::function<std::shared_ptr<CGameInterface>(PlayerColor)> & factory)
+{
+	if(!contextualEvidenceEnabled() || !experimentEvidenceHooks() || !state || gamestate)
+		throw std::runtime_error("Invalid contextual replay client initialization");
+	experimentReplayMode = true;
+	gamestate = std::move(state);
+	gamestate->preInit(LIBRARY);
+	GAME->setMapInstance(std::make_unique<CMapHandler>(&gameState().getMap()));
+	reinitScripting();
+	for(const auto color : {PlayerColor(0), PlayerColor(1)})
+	{
+		if(!gameState().players.contains(color) || gameState().players.at(color).isHuman())
+			throw std::runtime_error("Contextual replay requires the two AI-controlled baseline players");
+		playerEnvironments[color] = std::make_shared<CPlayerEnvironment>(color, this,
+			std::make_shared<CCallback>(gamestate, color, this));
+		installNewPlayerInterface(factory(color), color);
+	}
+}
+
+void CClient::acceptExperimentReplayAutomaticRequest(const CPackForServer & request)
+{
+	if(!experimentReplayMode || request.requestID != requestCounter.fetch_add(1, std::memory_order_relaxed))
+		throw std::runtime_error("Automatic replay request ID is out of order");
+	waitingRequest.pushBack(request.requestID);
 }
 
