+std::optional<std::vector<MetaStringOperation>> MetaString::operations() const
+{
+	using Kind = MetaStringOperation::Kind;
+	std::vector<MetaStringOperation> result;
+	result.reserve(message.size());
+
+	size_t exSt = 0;
+	size_t loSt = 0;
+	size_t nums = 0;
+	size_t textID = 0;
+
+	const auto exact = [&](MetaStringOperation & operation)
+	{
+		if(exSt >= exactStrings.size())
+			return false;
+		operation.text = exactStrings[exSt++];
+		return true;
+	};
+	const auto local = [&](MetaStringOperation & operation)
+	{
+		if(loSt >= localStrings.size())
+			return false;
+		const auto & [type, serial] = localStrings[loSt++];
+		switch(type)
+		{
+			case EMetaText::GENERAL_TXT:
+				operation.text = TextIdentifier("core.genrltxt", serial).get();
+				return true;
+			case EMetaText::ARRAY_TXT:
+				operation.text = TextIdentifier("core.arraytxt", serial).get();
+				return true;
+			case EMetaText::ADVOB_TXT:
+				operation.text = TextIdentifier("core.advevent", serial).get();
+				return true;
+			case EMetaText::JK_TXT:
+				operation.text = TextIdentifier("core.jktext", serial).get();
+				return true;
+			default:
+				return false;
+		}
+	};
+	const auto identifier = [&](MetaStringOperation & operation)
+	{
+		if(textID >= stringsTextID.size())
+			return false;
+		operation.text = stringsTextID[textID++];
+		return true;
+	};
+	const auto number = [&](MetaStringOperation & operation)
+	{
+		if(nums >= numbers.size())
+			return false;
+		operation.number = numbers[nums++];
+		return true;
+	};
+
+	for(const auto & elem : message)
+	{
+		MetaStringOperation operation;
+		bool complete = false;
+		switch(elem)
+		{
+			case EMessage::APPEND_RAW_STRING:
+				operation.kind = Kind::APPEND_RAW_STRING;
+				complete = exact(operation);
+				break;
+			case EMessage::APPEND_LOCAL_STRING:
+				operation.kind = Kind::APPEND_LOCAL_STRING;
+				complete = local(operation);
+				break;
+			case EMessage::APPEND_TEXTID_STRING:
+				operation.kind = Kind::APPEND_TEXTID_STRING;
+				complete = identifier(operation);
+				break;
+			case EMessage::APPEND_NUMBER:
+				operation.kind = Kind::APPEND_NUMBER;
+				complete = number(operation);
+				break;
+			case EMessage::REPLACE_RAW_STRING:
+				operation.kind = Kind::REPLACE_RAW_STRING;
+				complete = exact(operation);
+				break;
+			case EMessage::REPLACE_LOCAL_STRING:
+				operation.kind = Kind::REPLACE_LOCAL_STRING;
+				complete = local(operation);
+				break;
+			case EMessage::REPLACE_TEXTID_STRING:
+				operation.kind = Kind::REPLACE_TEXTID_STRING;
+				complete = identifier(operation);
+				break;
+			case EMessage::REPLACE_NUMBER:
+				operation.kind = Kind::REPLACE_NUMBER;
+				complete = number(operation);
+				break;
+			case EMessage::REPLACE_POSITIVE_NUMBER:
+				operation.kind = Kind::REPLACE_POSITIVE_NUMBER;
+				complete = number(operation);
+				break;
+			case EMessage::APPEND_EOL:
+				operation.kind = Kind::APPEND_EOL;
+				complete = true;
+				break;
+			default:
+				break;
+		}
+		if(!complete)
+			return std::nullopt;
+		result.push_back(std::move(operation));
+	}
+
+	if(exSt != exactStrings.size() || loSt != localStrings.size() || nums != numbers.size() || textID != stringsTextID.size())
+		return std::nullopt;
+	return result;
+}
