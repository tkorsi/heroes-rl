+/// One formatting operation of a MetaString with the pool entry it consumes, for
+/// consumers that must audit a message's exact structure instead of its rendered
+/// text. Local strings are given as their text identifiers.
+struct DLL_LINKAGE MetaStringOperation
+{
+	enum class Kind : uint8_t
+	{
+		APPEND_RAW_STRING,
+		APPEND_LOCAL_STRING,
+		APPEND_TEXTID_STRING,
+		APPEND_NUMBER,
+		REPLACE_RAW_STRING,
+		REPLACE_LOCAL_STRING,
+		REPLACE_TEXTID_STRING,
+		REPLACE_NUMBER,
+		REPLACE_POSITIVE_NUMBER,
+		APPEND_EOL
+	};
+
+	Kind kind = Kind::APPEND_EOL;
+	std::string text; ///< raw string or text identifier; empty for numbers and line ends
+	int64_t number = 0; ///< numbers only
+};
