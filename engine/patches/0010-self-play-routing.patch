+
+std::set<PlayerColor> CClient::configuredExplorerPlayers() const
+{
+	const char * singular = std::getenv("EXPLORER_RL_PLAYER");
+	const char * plural = std::getenv("EXPLORER_RL_PLAYERS");
+	if(singular && plural)
+		throw std::runtime_error("Set either EXPLORER_RL_PLAYER or EXPLORER_RL_PLAYERS, never both");
+	std::set<PlayerColor> players;
+	if(!singular && !plural)
+		return players;
+	const std::string configured = plural ? plural : singular;
+	if(configured.empty() || configured.size() % 2 == 0 || (!plural && configured.size() != 1))
+		throw std::runtime_error("ExplorerRL player indices must be distinct digits from 0 to 7 separated by commas");
+	for(size_t i = 0; i < configured.size(); ++i)
+	{
+		if(i % 2 == 1)
+		{
+			if(configured[i] != ',')
+				throw std::runtime_error("EXPLORER_RL_PLAYERS requires comma-separated player indices");
+			continue;
+		}
+		if(configured[i] < '0' || configured[i] > '7' || !players.emplace(configured[i] - '0').second)
+			throw std::runtime_error("ExplorerRL player indices must be distinct digits from 0 to 7");
+	}
+	return players;
+}
+
+bool CClient::recordExplorerTerminal(PlayerColor player, bool won)
+{
+	const auto expected = configuredExplorerPlayers();
+	if(!expected.contains(player) || !explorerTerminalsReceived.insert(player).second)
+		return false;
+	logAi->info("Experiment player %d %s. Terminal received.", player.getNum(), won ? "won" : "lost");
+	return explorerTerminalsReceived.size() == expected.size();
 }
 
