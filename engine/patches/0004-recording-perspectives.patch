+
+bool CPlayerInterface::isVisibleForRecording(const CGObjectInstance * object) const
+{
+	return recordingPlayer && !recordingOmniscient ? isVisibleToRecordingPlayer(object) : cb->isVisible(object);
+}
+
+bool CPlayerInterface::isVisibleToRecordingPlayer(const int3 & tile) const
+{
+	return recordingPlayer ? cb->isVisibleFor(tile, *recordingPlayer) : cb->isVisible(tile);
